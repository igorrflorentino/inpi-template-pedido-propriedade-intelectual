%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  Listas geradas: exibir só se houver %%
%%  conteúdo (figuras, tabelas, etc.)   %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% As listas pré-textuais geradas automaticamente (ilustrações, tabelas, quadros,
% algoritmos, códigos-fonte) leem, na passada anterior, o respectivo arquivo
% auxiliar: .lof / .lot / .loq / .loa / .lol. Em vez de imprimir um título
% órfão ("Lista de ..." em página vazia) quando não há o elemento, verificamos
% se esse arquivo tem conteúdo e só então imprimimos a lista.
%
% A checagem é feita diretamente sobre o arquivo que a própria lista consome,
% portanto independe de detalhes internos de cada pacote (memoir, algorithm2e,
% listings). Como usa o arquivo da passada anterior, o latexmk converge sozinho
% (a lista some/aparece e a recompilação por mudança de arquivo estabiliza).
% Detecção por \addcontentsline (o ponto único por onde TODA legenda registra
% sua entrada na lista correspondente — .lof/.lot/.loq/.loa/.lol). Não podemos
% checar a existência do arquivo .lof/.lot porque é o próprio \listoffigures/
% \listoftables que os cria: escondê-los impediria a criação do arquivo e a
% lista nunca voltaria. Por isso marcamos o uso via hook e, como as listas são
% pré-textuais (impressas antes do corpo), persistimos o estado no .aux para a
% passada seguinte — igual à Lista de Abreviaturas e Siglas.
%
% Flags SEM '@' no nome (catcode-seguro ao gravar/ler no .aux):
%   \ifembhas<ext> = usada na passada atual ; \ifembhad<ext> = na anterior.
% Obs.: num .sty '@' já é letra; os \makeatletter abaixo são apenas defensivos
% (mantêm os trechos que usam \@... internos válidos mesmo fora deste contexto).
\newif\ifembhaslof \newif\ifembhadlof  % ilustrações (figuras)
\newif\ifembhaslot \newif\ifembhadlot  % tabelas
\newif\ifembhasloq \newif\ifembhadloq  % quadros
\newif\ifembhasloa \newif\ifembhadloa  % algoritmos
\newif\ifembhaslol \newif\ifembhadlol  % códigos-fonte
\newif\ifembneedrerun

\makeatletter
% Envolve \addcontentsline para marcar a lista usada. Para #1 (tipo do arquivo:
% lof/lot/...), se existir a flag \ifembhas#1, liga-a globalmente. Usamos um
% wrap manual (\let + \renewcommand) por ser robusto independentemente de como
% \addcontentsline foi definido (o \apptocmd do etoolbox falha aqui).
\AtBeginDocument{%
	\let\embrapatex@orig@addcontentsline\addcontentsline
	\renewcommand\addcontentsline[3]{%
		\embrapatex@orig@addcontentsline{#1}{#2}{#3}%
		\@ifundefined{ifembhas#1}{}{\global\csname embhas#1true\endcsname}%
	}%
}

% Ao fim da passada, persiste no .aux quais listas têm conteúdo e pede um rerun
% ao latexmk quando alguma passou de ausente -> presente.
\AtEndDocument{%
	\if@filesw
		\ifembhaslof \immediate\write\@auxout{\string\global\string\embhadloftrue}\ifembhadlof\else\embneedreruntrue\fi\fi
		\ifembhaslot \immediate\write\@auxout{\string\global\string\embhadlottrue}\ifembhadlot\else\embneedreruntrue\fi\fi
		\ifembhasloq \immediate\write\@auxout{\string\global\string\embhadloqtrue}\ifembhadloq\else\embneedreruntrue\fi\fi
		\ifembhasloa \immediate\write\@auxout{\string\global\string\embhadloatrue}\ifembhadloa\else\embneedreruntrue\fi\fi
		\ifembhaslol \immediate\write\@auxout{\string\global\string\embhadloltrue}\ifembhadlol\else\embneedreruntrue\fi\fi
		\ifembneedrerun
			\@latex@warning@no@line{Rerun to get the lists of floats right}%
		\fi
	\fi
}
\makeatother

