% Tipo de documento — a escolha estrutural fundamental (três tipos):
%   academico    - Trabalhos de graduação/pós (TCC, monografia, dissertação,
%                  tese, relatório acadêmico/probatório). Banca, orientador,
%                  campos de pesquisa e instituição de ensino.
%                  Subtipo via \nivel. Ativa \ifacademico.
%   publicacao   - Publicações técnico-científicas da Embrapa (séries). É o
%                  PADRÃO do main.tex. Subtipo via \serie; número na capa.
%                  Ativa \ifpublicacao.
%   corporativo  - Relatórios e análises empresariais (modo NÃO acadêmico:
%                  sumário executivo; sem banca/ficha). Subtipo via \categoria.
%                  Ativa \ifcorporativo.
%
% Cada tipo tem seu PRÓPRIO seletor de subtipo (separação de responsabilidades):
%   \nivel{tcc|monografia|dissertacao|tese|relatorio}        (academico)
%   \serie{relatorio|boletim|comunicado|documento}           (publicacao)
%   \categoria{relatorio|analise|probatorio}                 (corporativo)
% O subtipo 'probatorio' (Relatório de Comprovação de Período Probatório) liga
% \ifprobatorio e habilita \imprimiridentificacao + \imprimirassinaturas.
% Os três só preenchem as variáveis de DADOS \subtitulodacapa (subtítulo da
% capa; vazio = sem subtítulo) e \naturezadapublicacao (frase do preâmbulo da
% folha de rosto). Para um caso não previsto, defina essas duas variáveis
% diretamente no main.tex.

% Definicao dos booleanos de tipo. \ifcorporativo é exposto ao main.tex (ramo
% pré-textual); \ifacademico/\ifpublicacao distinguem capa/folha/banca.
% O booleano embrapatex@ehcorporativo é consumido por \preambulo e \imprimircapa.
\provideboolean{embrapatex@ehcorporativo}
\setboolean{embrapatex@ehcorporativo}{false}
\newif\ifacademico  \academicofalse
\newif\ifpublicacao \publicacaotrue  % publicacao é o PADRÃO (igual ao main.tex)
\newif\ifcorporativo \corporativofalse
% Sub-flag do tipo corporativo: \categoria{probatorio} liga \ifprobatorio, usado
% pelo main.tex para renderizar a identificação do servidor (\imprimiridentificacao)
% e o bloco de assinatura (\imprimirassinaturas) do Relatório de Comprovação de
% Período Probatório. Falso em qualquer outro tipo/subtipo.
\newif\ifprobatorio \probatoriofalse

% \tipodocumento{academico|publicacao|corporativo} — só estes 3 valores valem.
% Qualquer outro é REJEITADO com erro.
\newcommand{\tipodocumento}[1]{
	\academicofalse \publicacaofalse \corporativofalse
	\setboolean{embrapatex@ehcorporativo}{false}
	\ifthenelse{\equal{#1}{academico}}{\academicotrue}{%
		\ifthenelse{\equal{#1}{publicacao}}{\publicacaotrue}{%
			\ifthenelse{\equal{#1}{corporativo}}{%
				\corporativotrue
				\setboolean{embrapatex@ehcorporativo}{true}%
			}{%
				\PackageError{embrapatex}{Tipo de documento '#1' invalido}{%
					Os unicos tipos validos sao 'academico', 'publicacao' e
					'corporativo'. O subtipo e definido por \string\nivel
					(academico), \string\serie (publicacao) ou \string\categoria
					(corporativo).}%
			}%
		}%
	}%
}

% Aviso leve quando um seletor é usado fora do seu tipo (reforça a separação;
% no uso normal o main.tex chama cada seletor dentro do \if<tipo> correspondente).
\newcommand{\embrapatex@avisotipo}[2]{%
	\PackageWarning{embrapatex}{\string#1\space so faz sentido no tipo '#2';
		verifique o \string\tipodocumento}%
}

% \nivel{...} — subtipo do tipo ACADEMICO (nível do trabalho).
\newcommand{\nivel}[1]{%
	\ifacademico\else\embrapatex@avisotipo{\nivel}{academico}\fi
	\subtitulodacapa{}%
	\ifthenelse{\equal{#1}{tese}}{%
		\naturezadapublicacao{Tese apresentada ao Programa de Pós-Graduação em \imprimirprogramapesquisa\ da \imprimirinstituicao, como requisito parcial para a obtenção do título de Doutor.}%
	}{\ifthenelse{\equal{#1}{dissertacao}}{%
		\naturezadapublicacao{Dissertação apresentada ao Programa de Pós-Graduação em \imprimirprogramapesquisa\ da \imprimirinstituicao, como requisito parcial para a obtenção do título de Mestre.}%
	}{\ifthenelse{\equal{#1}{monografia}}{%
		\naturezadapublicacao{Monografia apresentada ao curso de \imprimirprogramapesquisa\ da \imprimirinstituicao, como requisito parcial para a obtenção do título de Especialista.}%
	}{\ifthenelse{\equal{#1}{tcc}}{%
		\naturezadapublicacao{Trabalho de Conclusão de Curso apresentado ao curso de \imprimirprogramapesquisa\ da \imprimirinstituicao, como requisito parcial para a obtenção do grau de Bacharel.}%
	}{\ifthenelse{\equal{#1}{relatorio}}{%
		\naturezadapublicacao{Relatório apresentado à \imprimirinstituicao, submetido à avaliação da banca examinadora.}%
	}{%
		\PackageWarning{embrapatex}{Nivel '#1' desconhecido; use tcc, monografia, dissertacao, tese ou relatorio. Assumindo 'relatorio'}%
		\naturezadapublicacao{Relatório apresentado à \imprimirinstituicao, submetido à avaliação da banca examinadora.}%
	}}}}}%
}

% \serie{...} — subtipo do tipo PUBLICACAO (série de publicação da Embrapa).
\newcommand{\serie}[1]{%
	\ifpublicacao\else\embrapatex@avisotipo{\serie}{publicacao}\fi
	\ifthenelse{\equal{#1}{relatorio}}{%
		\subtitulodacapa{}%
		\naturezadapublicacao{Relatório Técnico apresentado à \imprimirunidade\ (\imprimirunidadesigla).}%
	}{\ifthenelse{\equal{#1}{boletim}}{%
		\subtitulodacapa{Boletim de Pesquisa e Desenvolvimento}%
		\naturezadapublicacao{Boletim de Pesquisa e Desenvolvimento da \imprimirunidade\ (\imprimirunidadesigla).}%
	}{\ifthenelse{\equal{#1}{comunicado}}{%
		\subtitulodacapa{Comunicado Técnico}%
		\naturezadapublicacao{Comunicado Técnico da \imprimirunidade\ (\imprimirunidadesigla).}%
	}{\ifthenelse{\equal{#1}{documento}}{%
		\subtitulodacapa{}%
		\naturezadapublicacao{Documento da \imprimirunidade\ (\imprimirunidadesigla).}%
	}{%
		\PackageWarning{embrapatex}{Serie '#1' desconhecida; use relatorio, boletim, comunicado ou documento. Assumindo 'relatorio'}%
		\subtitulodacapa{}%
		\naturezadapublicacao{Relatório Técnico apresentado à \imprimirunidade\ (\imprimirunidadesigla).}%
	}}}}%
}

% \categoria{...} — subtipo do tipo CORPORATIVO.
\newcommand{\categoria}[1]{%
	\ifcorporativo\else\embrapatex@avisotipo{\categoria}{corporativo}\fi
	\probatoriofalse
	\ifthenelse{\equal{#1}{relatorio}}{%
		\subtitulodacapa{Relatório}%
		\naturezadapublicacao{Relatório elaborado pela \imprimirunidade\ (\imprimirunidadesigla).}%
	}{\ifthenelse{\equal{#1}{analise}}{%
		\subtitulodacapa{Análise}%
		\naturezadapublicacao{Análise elaborada pela \imprimirunidade\ (\imprimirunidadesigla).}%
	}{\ifthenelse{\equal{#1}{probatorio}}{%
		\probatoriotrue
		\subtitulodacapa{Relatório de Comprovação de Período Probatório}%
		\naturezadapublicacao{Relatório de comprovação de período probatório apresentado à \imprimirunidade\ (\imprimirunidadesigla).}%
	}{%
		\PackageWarning{embrapatex}{Categoria '#1' desconhecida; use relatorio, analise ou probatorio. Assumindo 'relatorio'}%
		\subtitulodacapa{Relatório}%
		\naturezadapublicacao{Relatório elaborado pela \imprimirunidade\ (\imprimirunidadesigla).}%
	}}}%
}

