%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%   Exibição automática de elementos  %%
%%   opcionais (somente se preenchidos) %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Alguns elementos pós-textuais devem ficar SEMPRE disponíveis no main.tex,
% porém só aparecer no PDF quando de fato houver conteúdo — evitando títulos
% órfãos ("REFERÊNCIAS"/"GLOSSÁRIO"/"APÊNDICES" em página vazia).
%
% A detecção é automática e feita em uma única passada, pois estes elementos
% são impressos DEPOIS do corpo do texto:
%   - Referências: aparece se houver \cite/\citeonline/\nocite no documento.
%   - Glossário:   aparece se algum termo do glossário principal for usado
%                  com \gls/\Gls (siglas/acrônimos não contam — vão para a
%                  Lista de Abreviaturas e Siglas).
%   - Apêndices/Anexos: ver \imprimirapendices/\imprimiranexos (controle por
%                  conteúdo vazio, mais abaixo).

% --- Referências: marca se houve qualquer citação ---
% Compatibilidade com o antigo abntex2cite: \citeonline (citação textual, com o
% autor fora dos parênteses) vira um apelido de \textcite do biblatex.
% A detecção de "houve citação" (para a exibição automática das Referências) usa o
% hook oficial \AtEveryCite — que dispara em \cite/\parencite/\textcite/\citeonline/
% \citeauthor/... — e um embrulho em \nocite (que não passa por esse hook).
\newif\ifembrapatextemcitacao
\AtEveryCite{\global\embrapatextemcitacaotrue}
% O \nocite do biblatex é \protected e não aceita \pretocmd; por isso o embrulhamos
% à mão, no carregamento (onde o #1 é literal). \embrapatexorignocite guarda o original.
\let\embrapatexorignocite\nocite
\protected\def\nocite#1{\global\embrapatextemcitacaotrue\embrapatexorignocite{#1}}
% \citeonline = \textcite (compat. abntex2cite), fixado em \AtBeginDocument para
% capturar a versão final de \textcite (após o hyperref).
\AtBeginDocument{\let\citeonline\textcite}

% (O "et al." já sai em itálico por padrão no biblatex-abnt — o estilo abnt.bbx
% envolve a string "andothers" em \mkbibemph —, equivalente ao antigo
% abnt-etal-text=it do abntex2cite. Não é preciso redefinir nada; redefinir a
% própria string com \mkbibemph causaria itálico-dentro-de-itálico = texto reto.)

% Imprime as referências apenas quando há citações no documento. A base BibTeX é
% declarada por \addbibresource no preâmbulo (lib/preambulo.tex); o argumento #1 é
% mantido por compatibilidade com chamadas antigas \imprimirreferencias{...}, mas é
% ignorado (o caminho não é repassado ao biblatex aqui).
\newcommand{\imprimirreferencias}[1]{%
	\ifembrapatextemcitacao
		% O biblatex usa a string própria "Bibliografia" no título do capítulo; a
		% ABNT exige "Referências", então forçamos via title=. heading=bibintoc gera
		% o capítulo não numerado (estilo abntex2) e o registra no Sumário.
		\printbibliography[title={Refer\^encias},heading=bibintoc]%
	\fi
}

% --- Elementos carregados de arquivo (errata, dedicatória, agradecimentos,
%     epígrafe, lista de símbolos): só aparecem se o arquivo tiver conteúdo
%     real, isto é, alguma linha não-vazia depois de removidos os comentários.
% O arquivo é lido com \read (que descarta comentários e equilibra chaves) e
% \endlinechar=-1 (para que linhas em branco/comentadas não virem \par/espaço).
% Definido aqui (onde '@' é letra); o nome público \seArquivoComConteudo não usa
% '@', podendo ser chamado das macros mais abaixo (onde '@' não é letra).
\newread\embrapatex@filecheck
\newif\ifembrapatex@filecontent
\newcommand{\embrapatex@filecheckloop}{%
	\ifeof\embrapatex@filecheck\else
		\read\embrapatex@filecheck to \embrapatex@fileline
		\expandafter\ifblank\expandafter{\embrapatex@fileline}{}{%
			\global\embrapatex@filecontenttrue}%
		\expandafter\embrapatex@filecheckloop
	\fi
}
% \seArquivoComConteudo{<caminho sem .tex>}{<código se houver conteúdo>}
\newcommand{\seArquivoComConteudo}[2]{%
	\global\embrapatex@filecontentfalse
	\IfFileExists{#1.tex}{%
		\begingroup
			\endlinechar=-1\relax
			\openin\embrapatex@filecheck=#1.tex\relax
			\embrapatex@filecheckloop
			\closein\embrapatex@filecheck
		\endgroup
	}{}%
	\ifembrapatex@filecontent #2\fi
}

% --- Glossário e Lista de Siglas: detecta uso por tipo de glossário ---
% O \glspostlinkhook é executado após cada \gls/\Gls/\acrshort etc. Dentro
% dele, \glslabel é o rótulo da entrada atual e \glsentrytype dá o tipo do
% glossário a que ela pertence:
%   - tipo "main"    -> Glossário (pós-textual)
%   - tipo "acronym" -> Lista de Abreviaturas e Siglas (pré-textual)
\newif\ifembrapatexglossarioutil   % glossário usado (passada atual)
\newif\ifembrapatexsiglasutil      % siglas usadas  (passada atual)
\newif\ifembrapatexsiglasutilprev  % siglas usadas na passada ANTERIOR (lido do .aux)
\appto\glspostlinkhook{%
	\edef\embrapatex@curglstype{\glsentrytype{\glslabel}}%
	\ifdefstring{\embrapatex@curglstype}{main}{\global\embrapatexglossarioutiltrue}{}%
	\ifdefstring{\embrapatex@curglstype}{acronym}{\global\embrapatexsiglasutiltrue}{}%
}

% A Lista de Abreviaturas e Siglas é PRÉ-textual (impressa antes do corpo),
% logo o uso das siglas só é conhecido ao FIM da passada. Persistimos o estado
% no .aux: na passada seguinte, \ifembrapatexsiglasutilprev já estará correto
% quando a lista for impressa. O aviso "Rerun to get" faz o latexmk recompilar
% automaticamente até estabilizar (mesma técnica do pacote lastpage).
\AtEndDocument{%
	\if@filesw
		\ifembrapatexsiglasutil
			\immediate\write\@auxout{%
				\string\global\string\embrapatexsiglasutilprevtrue}%
			\ifembrapatexsiglasutilprev\else
				\@latex@warning@no@line{Rerun to get the Lista de
					Abreviaturas e Siglas right}%
			\fi
		\fi
	\fi
}

