% Largura da lista de abreviaturas (desconta a coluna da sigla e padding da tabela)
\setlength{\glsdescwidth}{\dimexpr\linewidth-3cm\relax}

% Só imprime a lista quando alguma sigla/abreviatura foi usada no texto com
% \gls/\acrshort etc. A detecção é da passada anterior (\...prev), pois esta
% lista é pré-textual — ver a nota em \AtEndDocument acima.
% Bloco em \makeatletter porque, neste ponto do .sty, vem DEPOIS de um
% \makeatother do arquivo (acima) — sem o wrapper, '@' não é letra e o nome
% \embrapatex@savedtable abaixo não formaria um único \controlsequence.
\makeatletter
\newcommand{\imprimirlistadeabreviaturasesiglas}{ %
	\ifembrapatexsiglasutilprev
		% O estilo 'long' do glossaries é baseado em 'longtable', que consome
		% um número do contador 'table'. Como esta é uma lista PRÉ-TEXTUAL,
		% ela não deve gastar numeração de tabela: sem isto, a primeira tabela
		% do texto (e da Lista de Tabelas) começaria em "2". Salvamos e
		% restauramos o contador ao redor da impressão.
		\edef\embrapatex@savedtable{\the\value{table}}%
		\printglossary[type=\acronymtype,style=long,nonumberlist,title={Lista de Abreviaturas e Siglas\vspace{-0.3cm}}] %
		\setcounter{table}{\embrapatex@savedtable}%
		\pagebreak %
	\fi
}
\makeatother

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%         Lista de Simbolos           %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% A lista de símbolos só aparece se o arquivo contiver ao menos um \item.
% O ambiente "simbolos" (que imprime o título) fica AQUI, no wrapper, e não no
% arquivo de conteúdo — assim, um arquivo só com comentários é detectado como
% vazio e a lista (com seu título) é omitida.
\newcommand{\imprimirlistadesimbolos}[1]{
	\seArquivoComConteudo{#1}{%
		\begin{simbolos}\itemsep -1pt %
			\input{#1}%
		\end{simbolos}%
	}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%              Glossário              %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Glossario desenvolvido para o EmbrapaTex
\setlist{nosep}
\newglossarystyle{glossario-embrapa}{%
	%
	\renewenvironment{theglossary}%
	{\vspace{-0.3cm}\begin{description}[leftmargin=0cm]\itemsep -1pt}{\end{description}}%
	%
	\renewcommand*{\glossaryheader}{}%

	% indicate what to do at the start of each logical group

	\renewcommand*{\glsgroupheading}[1]{%
		\vspace{0cm}\item[{\glsgetgrouptitle{##1}}] \vspace{\onelineskip}
	}
	%
	\renewcommand*{\glsgroupskip}{}%
	% Depois da palavra, colocar o ":" e no fim o ponto final "."
	\renewcommand*{\glossentry}[2]{%
		\item[\glstarget{##1}{\glossentryname{##1}}:] \glossentrydesc{##1}.%
	}%
}

% Só imprime o glossário (e seu título/entrada no sumário) quando há ao menos
% um termo do glossário principal efetivamente usado no texto.
\newcommand{\imprimirglossario}{ %
	\ifembrapatexglossarioutil
		\setglossarystyle{glossario-embrapa} %
		\printglossary[title=GLOSSÁRIO,toctitle=GLOSSÁRIO] %
		\addcontentsline{toc}{chapter}{GLOSSÁRIO}
	\fi
}


