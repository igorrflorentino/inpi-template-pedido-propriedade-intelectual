\setlength{\ABNTEXsignskip}{\onelineskip}

% Monta uma assinatura da banca omitindo as linhas (centro/IES) que estiverem
% vazias — evita o erro "There's no line here to end" causado por \\ consecutivos
% quando algum campo fica em branco.
\newcommand{\assinaturabanca}[3]{%
	\assinatura{#1%
		\ifnotempty{#2}{\\ #2}{}%
		\ifnotempty{#3}{\\ #3}{}}%
}

\newcommand{\imprimirfolhadeaprovacaopadrao}{

	\begin{center}
		\MakeUppercase{\imprimirautor}\par
		\vspace{\onelineskip}
		\vspace{\onelineskip}
		\MakeUppercase{\imprimirtitulo}
	\end{center}

	\vspace{\onelineskip}
	\vspace{\onelineskip}

	% Desloca o bloco seguinte para a metade direita da página: o -2cm cancela
	% a margem/indentação à esquerda e o 8cm reposiciona o início do minipage
	% à direita (recuo característico exigido pela ABNT nestes elementos).
	\noindent\hspace*{-2cm}
	\hspace*{8cm}
	\begin{minipage}{8cm}
		\begin{SingleSpace}
			\sloppy
			\imprimirpreambulo
		\end{SingleSpace}
	\end{minipage}\hfill

	\vspace{\onelineskip}

	\noindent Aprovada em: \imprimirdataaprovacao

	\vspace{\onelineskip}

	\begin{center}
		BANCA EXAMINADORA / REVISORES
	\end{center}
		\vspace{\onelineskip}

	% Membro Um da banca é sempre o Orientador
	\assinaturabanca{\imprimirorientador\  \artigoorientadorcomparenteses}{\imprimirorientadorcentro}{\imprimirorientadories}

	% Membro Dois da banca pode ser o coorientador ou outro membro
	\ifnotempty{\imprimircoorientador}{
		\assinaturabanca{\imprimircoorientador\ \artigocoorientadorcomparenteses}{\imprimircoorientadorcentro}{\imprimircoorientadories}
	}

	% Membro Três da banca pode ser o coorientador ou outro membro
	\ifnotempty{\imprimirmembrodabancadois}{
		\assinaturabanca{\imprimirmembrodabancadois}{\imprimirmembrodabancadoiscentro}{\imprimirmembrodabancadoisies}
	}

	% Membro Quatro
	\ifnotempty{\imprimirmembrodabancatres}{
		\assinaturabanca{\imprimirmembrodabancatres}{\imprimirmembrodabancatrescentro}{\imprimirmembrodabancatresies}
	}

	% Membro Cinco
	\ifnotempty{\imprimirmembrodabancaquatro}{
		\assinaturabanca{\imprimirmembrodabancaquatro}{\imprimirmembrodabancaquatrocentro}{\imprimirmembrodabancaquatroies}
	}

	% Membro Seis
	\ifnotempty{\imprimirmembrodabancacinco}{
		\assinaturabanca{\imprimirmembrodabancacinco}{\imprimirmembrodabancacincocentro}{\imprimirmembrodabancacincoies}
	}

	% Membro Sete
	\ifnotempty{\imprimirmembrodabancaseis}{
		\assinaturabanca{\imprimirmembrodabancaseis}{\imprimirmembrodabancaseiscentro}{\imprimirmembrodabancaseisies}
	}

	\pagebreak
}

