% Capa ÚNICA para os três tipos, sensível por dados:
%  - topo: instituição de ensino (academico) ou unidade Embrapa (publicacao/corporativo);
%  - subtítulo: \subtitulodacapa (vazio = sem subtítulo), definido pelo seletor;
%  - número do documento: só em publicacao, se preenchido.
\newcommand{\imprimircapapublicacao}{%
	\begin{capa}%
		% Todos os elementos da capa centralizados (\center) e em negrito
		\center
		\bfseries

        \includegraphics[scale=0.15]{lib/logo-embrapa-color-cropped.png} \\
        \vspace{0.3cm}
		% Topo: instituição de ensino (academico) ou unidade Embrapa (demais)
		\ifacademico
			\ifnotempty{\imprimirinstituicao}%
				{\MakeUppercase{\imprimirinstituicao}}%
				{\MakeUppercase{\imprimirunidade}} \\
		\else
			\MakeUppercase{\imprimirunidade} \\
		\fi
		\abntex@ifnotempty{\imprimircentro}{
			\MakeUppercase{\imprimircentro} \\
		}
		\abntex@ifnotempty{\imprimirsubtitulodacapa}{
			\MakeUppercase{\imprimirsubtitulodacapa} \\
		}
		% Número do documento — séries Embrapa (publicacao)
		\ifpublicacao
			\abntex@ifnotempty{\imprimirnumerodocumento}{
				\MakeUppercase{\imprimirnumerodocumento} \\
			}
		\fi

		\vspace{2cm}

		\MakeUppercase{\imprimirautor}

		\vspace{5cm}

		\MakeUppercase{\imprimirtitulo}

		\vfill
		\normalsize\MakeUppercase\imprimirlocal\par
		\normalsize\imprimirdata
	\end{capa}
}

\renewcommand{\imprimircapa}{%
	% Toda capa deve ter pagina 0. O subtítulo já foi definido pelo seletor de
	% subtipo (\nivel/\serie/\categoria); a capa abaixo o imprime se não vazio.
	\setcounter{page}{0}%
	\imprimircapapublicacao
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%           Folha de Rosto            %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\renewcommand{\folhaderostocontent}{
	\begin{center}
		\normalsize\MakeUppercase\imprimirautor\par
		\vspace{6.5cm}\par
		\normalsize\MakeUppercase\imprimirtitulo
	\end{center}

	\vspace{2.5cm}

	% Desloca o bloco seguinte para a metade direita da página: o -2cm cancela
	% a margem/indentação à esquerda e o 8cm reposiciona o início do minipage
	% à direita (recuo característico exigido pela ABNT nestes elementos).
	\noindent\hspace*{-2cm}
	\hspace*{8cm}
	\begin{minipage}{8cm}
		\begin{SingleSpace}
			\sloppy
			\imprimirpreambulo\par
			% Campos de pesquisa (academico): área de concentração e linha de
			% pesquisa, impressos só quando preenchidos.
			\ifacademico
				\abntex@ifnotempty{\imprimirareadepesquisa}{%
					\vspace{\onelineskip}%
					Área de concentração: \ignorespaces\imprimirareadepesquisa\par}%
				\abntex@ifnotempty{\imprimirlinhapesquisa}{%
					\vspace{\onelineskip}%
					Linha de pesquisa: \ignorespaces\imprimirlinhapesquisa\par}%
			\fi
			% Orientador — só se preenchido (limpa a folha de publicacao/corporativo)
			\abntex@ifnotempty{\imprimirorientador}{%
				\vspace{\onelineskip}%
				\artigoorientador: \ignorespaces\imprimirorientador\par}%
			\abntex@ifnotempty{\imprimircoorientador}{
				\vspace{\onelineskip}
				\artigocoorientador: \ignorespaces\imprimircoorientador\par
			}
		\end{SingleSpace}
	\end{minipage}\hfill

	\vfill
	\centering
	\normalsize\MakeUppercase\imprimirlocal \par
	\normalsize\imprimirdata
}
\makeatother

% Correção da ordem folha de rosto / ficha catalográfica.
% O \imprimirfolhaderosto do abntex2 é definido com \@ifstar + subcomandos que
% exigem um argumento que o corpo nunca repassa; quando chamado sem argumento
% (uso padrão), ele acaba consumindo o PRÓXIMO token do documento — no nosso
% caso \imprimirfichacatalografica — como se fosse seu argumento. Isso fazia a
% ficha ser processada DENTRO da folha de rosto, aparecendo ANTES dela.
% Redefinimos para uma versão simples que renderiza a folha de rosto sem
% consumir o token seguinte, restaurando a ordem (folha de rosto → ficha).
\renewcommand{\imprimirfolhaderosto}{%
	\begin{folhaderosto}%
		\folhaderostocontent
	\end{folhaderosto}%
}

