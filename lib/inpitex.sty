\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[brazilian]{babel}
\RequirePackage{helvet}                 % Helvetica ~ Arial, a fonte dos formulários oficiais
\RequirePackage{setspace}               % entrelinha 1,5 (art. 17)
\RequirePackage{geometry}               % margens e travamento do nº de linhas por página
\RequirePackage{fancyhdr}               % paginação n/N na margem superior (art. 16, II)
\RequirePackage{lastpage}               % total de páginas DESTA parte
\RequirePackage{enumitem}               % numeração das reivindicações (art. 28, I)
\RequirePackage{graphicx}               % figuras — só no documento de desenhos (art. 19)
\RequirePackage{amsmath}                % expressões matemáticas (art. 20)
\RequirePackage{array}
\RequirePackage{booktabs}
