%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%      Tipografia e layout             %%
%%  (arts. 16, 17 e 21)                 %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Art. 17 — "caracteres de, no mínimo, 2,1 mm de altura (corpo 12)". Os
% formulários oficiais do e-Patentes usam Arial; adotamos a Helvetica, sua
% equivalente métrica livre, sem escalonamento para não reduzir a altura.
\renewcommand{\familydefault}{\sfdefault}

% Art. 17 — entrelinha 1½.
\onehalfspacing

% Art. 17 — justificado (a norma admite também alinhado à esquerda).
% Sem recuo de primeira linha: o recuo pendente do rótulo [00N] faz esse papel,
% como nos formulários oficiais (AppBody-Description: left=357, hanging=357).
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35\baselineskip}

% Art. 16, II — a paginação vai na MARGEM SUPERIOR, portanto o cabeçalho fica
% acima da caixa de texto (includehead=false) e dentro da margem.
%
% Art. 17 — "entre 20 e 35 linhas de texto por página". Em vez de deixar o
% número de linhas ao acaso das margens, travamos a altura da caixa de texto em
% \inpi@linhasporpagina linhas: assim nenhuma página pode estourar o teto de 35.
% O \normalsize abaixo NÃO é decorativo: a chave 'lines' do geometry calcula a
% altura da caixa de texto a partir do \baselineskip vigente, e o
% \onehalfspacing acima só altera o \baselineskip na próxima seleção de fonte.
% Sem este \normalsize, o cálculo usaria a entrelinha simples e caberiam ~46
% linhas por página, estourando o teto de 35 do art. 17.
\normalsize
\geometry{
    a4paper,
    left=2.5cm,
    right=2.5cm,
    top=2.5cm,
    lines=31,
    headheight=15pt,
    headsep=14pt,
    includehead=false,
    includefoot=false
}

% Art. 16, I e II — numeração independente por documento, no formato n/N, em
% algarismos arábicos, centralizada na margem superior. Como cada parte do
% pedido é um PDF próprio, \pageref{LastPage} devolve o total DAQUELA parte e a
% contagem recomeça em 1 naturalmente.
%
% Art. 21 — nada mais no cabeçalho e nada no rodapé: sem timbre, sem logotipo,
% sem filete, sem qualquer indicação estranha à matéria do pedido.
% \inpi@marcadecomparacao fica VAZIA no documento do pedido; só a cópia de
% comparação a preenche (ver \copiadecomparacao, adiante). É por isso que ela
% aparece no cabeçalho sem violar o art. 21: no documento que se anexa ao
% peticionamento ela não imprime nada.
\newcommand{\inpi@marcadecomparacao}{}
\fancypagestyle{inpi}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
    \fancyhead[L]{\inpi@marcadecomparacao}%
    \fancyhead[C]{\thepage/\pageref{LastPage}}%
}
\pagestyle{inpi}
% O 'plain' é o estilo que o LaTeX impõe em algumas páginas por conta própria;
% igualamos os dois para que nenhuma página fique sem a paginação exigida.
\fancypagestyle{plain}{%
    \fancyhf{}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}%
    \fancyhead[L]{\inpi@marcadecomparacao}%
    \fancyhead[C]{\thepage/\pageref{LastPage}}%
}

% Corpos de letra observados nos formulários oficiais e-Patentes 4.0:
%   título do pedido  16 pt negrito centralizado  (estilo AppBody-Title)
%   título de seção   14 pt negrito à esquerda    (estilo AppBody-Heading)
%   corpo do texto    12 pt                       (estilo AppBody-Description)
\newcommand{\inpi@fontetitulo}{\fontsize{16}{19}\selectfont\bfseries}
\newcommand{\inpi@fontesecao}{\fontsize{14}{17}\selectfont\bfseries}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     Dados do pedido (metadados)      %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Título do pedido — art. 24: até 500 caracteres, sem denominação de fantasia,
% sem fórmula química ou matemática, e IDÊNTICO no relatório descritivo e no
% resumo. Daí a fonte única: os dois documentos leem esta mesma macro.
\newcommand{\inpi@titulo}{}
\newcommand{\titulodopedido}[1]{\protected@edef\inpi@titulo{#1}}

% ---------------------------------------------------------------------------
% Eixo 1 — NATUREZA da proteção pretendida.
%   invencao             patente de invenção      (reivindicações: arts. 29 a 31)
%   modelo-de-utilidade  patente de modelo de     (reivindicações: arts. 32 a 36;
%                        utilidade                 desenhos obrigatórios, art. 22)
% ---------------------------------------------------------------------------
\newif\ifinvencao
\newif\ifmodelodeutilidade
\newcommand{\nomedanatureza}{}   % "invenção" | "modelo de utilidade"
\newcommand{\danatureza}{}       % "da invenção" | "do modelo de utilidade"

% Vocabulário das concretizações — NÃO é sinônimo escolhido por gosto.
%
% O art. 27, VII veda, no relatório descritivo de MODELO DE UTILIDADE, "trechos
% do tipo 'concretização preferida', 'a título exemplificativo' etc.". A razão é
% de direito material: o modelo de utilidade protege uma forma ou disposição
% determinada (art. 9º da LPI), não um princípio que admita concretizações
% alternativas. Escrever "concretização" ali sugere justamente o contrário.
%
% Por isso o par abaixo, que troca o vocabulário junto com a natureza:
%   \secaodasconcretizacoes  título da seção
%   \nomedaconcretizacao     a palavra, no corpo do texto
\newcommand{\secaodasconcretizacoes}{}
\newcommand{\nomedaconcretizacao}{}

\newcommand{\natureza}[1]{%
    \protected@edef\inpi@natureza{#1}%
    \ifdefstring{\inpi@natureza}{invencao}{%
        \invencaotrue \modelodeutilidadefalse
        \renewcommand{\nomedanatureza}{invenção}%
        \renewcommand{\danatureza}{da invenção}%
        \renewcommand{\secaodasconcretizacoes}{Exemplos de concretizações da
            invenção}%
        \renewcommand{\nomedaconcretizacao}{concretização}%
    }{%
        \ifdefstring{\inpi@natureza}{modelo-de-utilidade}{%
            \invencaofalse \modelodeutilidadetrue
            \renewcommand{\nomedanatureza}{modelo de utilidade}%
            \renewcommand{\danatureza}{do modelo de utilidade}%
            \renewcommand{\secaodasconcretizacoes}{Variações construtivas do
                modelo de utilidade}%
            \renewcommand{\nomedaconcretizacao}{variação construtiva}%
        }{%
            \PackageError{inpitex}{%
                Natureza desconhecida: '#1'.\MessageBreak
                Use \protect\natureza{invencao} ou
                \protect\natureza{modelo-de-utilidade}%
            }{Corrija o valor em dados-do-pedido.tex.}%
        }%
    }%
}
\natureza{invencao}   % padrão

% ---------------------------------------------------------------------------
% Eixo 2 — MODALIDADE do depósito. Muda a menção que vem logo após o título do
% relatório descritivo (e nada mais na forma dos documentos).
%   originario         depósito comum
%   adicao             certificado de adição de invenção (art. 43, II)
%   divisao            pedido dividido                   (art. 51, II)
%   fase-nacional-pct  entrada na fase nacional via PCT  (Portaria 39/2021)
% ---------------------------------------------------------------------------
\newif\ifpedidooriginario
\newif\ifcertificadodeadicao
\newif\ifpedidodividido
\newif\iffasenacionalpct

\newcommand{\modalidade}[1]{%
    \protected@edef\inpi@modalidade{#1}%
    \pedidooriginariofalse \certificadodeadicaofalse
    \pedidodivididofalse   \fasenacionalpctfalse
    \ifdefstring{\inpi@modalidade}{originario}{\pedidooriginariotrue}{%
    \ifdefstring{\inpi@modalidade}{adicao}{\certificadodeadicaotrue}{%
    \ifdefstring{\inpi@modalidade}{divisao}{\pedidodivididotrue}{%
    \ifdefstring{\inpi@modalidade}{fase-nacional-pct}{\fasenacionalpcttrue}{%
        \PackageError{inpitex}{%
            Modalidade desconhecida: '#1'.\MessageBreak
            Use originario, adicao, divisao ou fase-nacional-pct%
        }{Corrija o valor em dados-do-pedido.tex.}%
    }}}}%
}
\modalidade{originario}   % padrão

% Número do pedido ou da patente a que este documento se vincula. Obrigatório
% nas modalidades 'adicao' (art. 43, II) e 'divisao' (art. 51, II).
\newcommand{\inpi@vinculado}{}
\newcommand{\pedidovinculado}[1]{\protected@edef\inpi@vinculado{#1}}

% Coerência entre os dois eixos e os campos obrigatórios, checada na abertura
% do documento (\AtBeginDocument) para que valha qualquer ordem de preenchimento.
\AtBeginDocument{%
    \ifdefempty{\inpi@titulo}{%
        \PackageError{inpitex}{%
            O titulo do pedido esta vazio.\MessageBreak
            Preencha \protect\titulodopedido{...} em dados-do-pedido.tex%
        }{O art. 24 da Portaria INPI/DIRPA 14/2024 exige o titulo.}%
    }{}%
    \ifcertificadodeadicao
        \ifmodelodeutilidade
            \PackageError{inpitex}{%
                Certificado de adicao so existe para patente de invencao.\MessageBreak
                Ver arts. 42 e 43 da Portaria INPI/DIRPA 14/2024%
            }{Use \protect\natureza{invencao} ou outra modalidade.}%
        \fi
    \fi
    \ifboolexpr{ bool {certificadodeadicao} or bool {pedidodividido} }{%
        \ifdefempty{\inpi@vinculado}{%
            \PackageError{inpitex}{%
                Falta o numero do pedido/patente vinculado.\MessageBreak
                Preencha \protect\pedidovinculado{...} em dados-do-pedido.tex%
            }{Exigido pelos arts. 43, II e 51, II.}%
        }{}%
    }{}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%   Parágrafos numerados (art. 26, II) %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Art. 26, II — "indicar cada parágrafo com uma numeração sequencial, em
% algarismos arábicos, localizada à esquerda do texto, como por exemplo [003],
% [015]". O rótulo fica na primeira linha e as linhas seguintes recuam,
% reproduzindo o recuo pendente dos formulários oficiais.
\newcounter{paragrafoinpi}

% Largura reservada ao rótulo. Os formulários oficiais usam 0,63 cm para o
% formato de um dígito; com três dígitos ([001]) é preciso um pouco mais.
\newlength{\inpirecuoparagrafo}
\setlength{\inpirecuoparagrafo}{1.2cm}

% Zero à esquerda até três dígitos: 1 -> 001, 27 -> 027, 145 -> 145.
\newcommand{\inpi@tresdigitos}[1]{%
    \ifnum#1<10 00\else\ifnum#1<100 0\fi\fi\number#1%
}
\newcommand{\inpi@rotulo}{[\inpi@tresdigitos{\value{paragrafoinpi}}]}

% Formato do rótulo: 'tres-digitos' (padrão, como no exemplo da norma) ou
% 'arabico' ([1], [2], ... como nos formulários oficiais).
\newcommand{\formatorotuloparagrafo}[1]{%
    \protected@edef\inpi@fmtrotulo{#1}%
    \ifdefstring{\inpi@fmtrotulo}{tres-digitos}{%
        \renewcommand{\inpi@rotulo}{[\inpi@tresdigitos{\value{paragrafoinpi}}]}%
    }{%
        \ifdefstring{\inpi@fmtrotulo}{arabico}{%
            \renewcommand{\inpi@rotulo}{[\arabic{paragrafoinpi}]}%
        }{%
            \PackageError{inpitex}{%
                Formato de rotulo desconhecido: '#1'.\MessageBreak
                Use tres-digitos ou arabico%
            }{Corrija a chamada de \protect\formatorotuloparagrafo.}%
        }%
    }%
}

% \pnum abre um parágrafo numerado. Uso:
%
%     \pnum A presente invenção refere-se a ...
%
%     \pnum Em uma concretização preferida ...
%
% Não recebe argumento de propósito: assim tabelas, fórmulas e expressões
% matemáticas podem ser intercaladas entre parágrafos sem quebrar nenhum
% ambiente de lista.
\newcommand{\pnum}{%
    \par
    \refstepcounter{paragrafoinpi}%
    \noindent
    \hangindent\inpirecuoparagrafo
    \hangafter=1
    \makebox[\inpirecuoparagrafo][l]{\inpi@rotulo}%
    \ignorespaces
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%      Títulos de seção do relatório   %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% As seções do relatório descritivo seguem a ordem do art. 27 (incisos I a IX).
% Não há numeração de capítulo/seção nem sumário no pedido de patente, então o
% título é apenas um rótulo tipográfico.
\newcommand{\secaoinpi}[1]{%
    \par\addvspace{\baselineskip}%
    \noindent{\inpi@fontesecao #1}%
    \par\nobreak\addvspace{0.3\baselineskip}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     Tabelas e fórmulas (art. 20)     %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Art. 20 — "Tabelas, fórmulas ou estruturas químicas e expressões matemáticas,
% quando inseridas no texto do relatório descritivo ou nas reivindicações,
% deverão ser apresentadas na cor preta e identificadas de forma sequencial."
%
% A legenda vai ACIMA da tabela, como nos formulários oficiais
% ("Tabela 1 - Exemplos Comparativos"). Nada de linha "Fonte:" — isso é
% elemento da ABNT, estranho ao pedido de patente (art. 21).
%
% Uso:
%     \begin{tabelainpi}{Exemplos comparativos}
%         \begin{tabular}{lll}
%             ...
%         \end{tabular}
%     \end{tabelainpi}
%
% DUAS DECISÕES DE IMPLEMENTAÇÃO QUE NÃO DEVEM SER DESFEITAS:
%
% (a) NÃO se usa o ambiente 'center' aqui, e sim \centering. O 'center' é um
%     'trivlist', e uma 'longtable' dentro de lista NÃO quebra de página: ela
%     transborda o fim da página, o LaTeX emite apenas um "Overfull \vbox" (que
%     é aviso, não erro, e portanto passa incólume pelo -halt-on-error) e as
%     linhas excedentes SOMEM do PDF. Matéria escrita na fonte que não sai no
%     documento assinado é o pior erro que este template poderia permitir. Com
%     \centering a 'longtable' quebra normalmente. A rede de conformidade ainda
%     checa "Overfull" nos .log como segunda barreira.
%
% (b) A legenda é presa ao corpo da tabela por \penalty\@M dos dois lados da
%     cola vertical, E a própria legenda é tornada indivisível por
%     \interlinepenalty\@M. As duas coisas são necessárias: sem os \penalty a
%     legenda fica órfã no pé de uma página e a tabela começa na seguinte; sem o
%     \interlinepenalty uma legenda de duas linhas se parte no meio, e a
%     primeira linha fica sozinha na página anterior. Nos dois casos a
%     "identificação sequencial" que o art. 20 exige acaba longe da tabela que
%     ela identifica. (Cola precedida de penalidade não é ponto de quebra
%     legítimo para o TeX — é assim que os \penalty seguram as duas juntas.)
\newcounter{tabelainpi}
\newenvironment{tabelainpi}[1]{%
    \par\addvspace{\baselineskip}%
    \refstepcounter{tabelainpi}%
    \begingroup
    \centering
    \begin{singlespace}%
    \interlinepenalty\@M
    Tabela \arabic{tabelainpi} -- #1\par
    \penalty\@M
    \vskip 0.4\baselineskip
    \penalty\@M
}{%
    \end{singlespace}%
    \par
    \endgroup
    \addvspace{0.5\baselineskip}%
}

% Colunas de LARGURA FIXA, para a tabela caber na caixa de texto.
%
%   L{<largura>}  quebra linha, alinhada à esquerda
%   R{<largura>}  quebra linha, alinhada à direita (é o caso dos números)
%   C{<largura>}  quebra linha, centralizada
%
% Com as colunas 'l', 'r' e 'c' do LaTeX a tabela tem a largura que o conteúdo
% pedir, e uma tabela mais larga que a caixa de texto imprime PARA FORA da
% margem — o LaTeX só emite um "Overfull \hbox", que é aviso e não erro. Com
% larguras fixas somando menos que \linewidth isso não acontece. Prefira
% frações de \linewidth a medidas absolutas: continuam certas se a margem mudar.
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}

% Tabela que passa de uma página: use 'longtable' no lugar de 'tabular', com
% \endhead para repetir o cabeçalho. O ambiente tabelainpi já a acomoda.
%
%     \begin{tabelainpi}{Ensaios de durabilidade}
%         \begin{longtable}{lrr}
%             \toprule Ciclo & Vazão & Pressão \\ \midrule \endhead
%             \bottomrule \endfoot
%             ...
%         \end{longtable}
%     \end{tabelainpi}
%
% Expressões matemáticas: use o ambiente 'equation' do amsmath, que já numera
% sequencialmente. Estruturas químicas podem ser inseridas como texto em preto.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%   Reivindicações (arts. 18 e 28)     %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Art. 28, I — cada reivindicação numerada consecutivamente em algarismos
% arábicos. Art. 28, II — uma única expressão "caracterizado por".
% Art. 28, III — redigida sem interrupção por pontos (um único ponto final).
%
% Uso:
%     \begin{quadroreivindicatorio}
%         \reivindicacao COMPOSIÇÃO ..., caracterizada por ...
%         \reivindicacao COMPOSIÇÃO ..., de acordo com a reivindicação 1, ...
%     \end{quadroreivindicatorio}
%
% leftmargin e labelwidth são deliberadamente iguais, com labelsep por cima: o
% enumitem resolve a sobredeterminação a favor do leftmargin, e o resultado é o
% recuo pendente dos formulários oficiais (AppBody-Claim: left=714, hanging=357
% twips, ou seja 1,26 cm com rótulo de 0,63 cm). Está conferido contra o PDF
% gerado — não "corrija" a aritmética sem olhar a saída.
\newlist{quadroreivindicatorio}{enumerate}{1}
\setlist[quadroreivindicatorio]{
    label=\arabic*.,
    leftmargin=\inpirecuoparagrafo,
    labelsep=0.4em,
    labelwidth=\inpirecuoparagrafo,
    align=left,
    topsep=\baselineskip,
    itemsep=0.6\baselineskip,
    parsep=0pt,
    partopsep=0pt
}
% Apelido em português para o \item, para que o arquivo de conteúdo se leia
% como o quadro reivindicatório que ele é.
\newcommand{\reivindicacao}{\item}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%   Cópia de comparação                %%
%%   (arts. 51, III e 57)               %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Quando se apresenta modificação depois do depósito, ou quando se deposita um
% pedido dividido, a norma pede DOIS documentos que saem da MESMA matéria:
%
%   art. 57, I    os documentos modificados, "sem qualquer tipo de rasura ou
%                 sinalização" — ou seja, o texto final, limpo;
%   art. 57, II   uma cópia de comparação indicando a localização das
%                 alterações, com marcação de TACHADO indicando remoção e
%                 SUBLINHADO indicando inclusão ou substituição.
%   art. 51, III  o mesmo, para o quadro reivindicatório do pedido dividido em
%                 relação ao último quadro apresentado no pedido original.
%
% Manter os dois à mão é duplicar a matéria e garantir que uma hora as duas
% versões divirjam. Aqui há uma fonte só: você marca as alterações no texto com
% as macros abaixo, e o mesmo arquivo gera as duas saídas.
%
%   \copiadecomparacao{nao}  (padrão) — documento do pedido. \removido some por
%                            completo e \incluido imprime texto normal: o
%                            resultado não tem sinalização nenhuma, como exige
%                            o art. 57, I.
%   \copiadecomparacao{sim}  — cópia de comparação. \removido sai tachado e
%                            \incluido sublinhado, e o cabeçalho passa a
%                            identificar o documento.
%
% A troca é feita pelo ./gerar-copia-de-comparacao.sh, que gera os PDFs
% *-comparacao.pdf sem que você precise editar dados-do-pedido.tex — assim não
% há risco de anexar ao peticionamento a versão marcada.
%
% O parágrafo único do art. 57 permite substituir a cópia de comparação por um
% esclarecimento apontando página, trecho e tipo de modificação. Se preferir
% esse caminho, escreva-o em prosa na petição; não é caso para estas macros.

\newif\ifcopiadecomparacao

\newcommand{\copiadecomparacao}[1]{%
    \protected@edef\inpi@modocomparacao{#1}%
    \ifdefstring{\inpi@modocomparacao}{sim}{%
        \copiadecomparacaotrue
        \renewcommand{\inpi@marcadecomparacao}{\footnotesize CÓPIA DE COMPARAÇÃO}%
        % O ulem NÃO hifeniza o que está dentro de \sout e \uline. Num idioma de
        % palavras longas como o português, um trecho marcado que caia no fim da
        % linha não tem onde quebrar e a linha transborda a caixa de texto — o
        % LaTeX só avisa, e a cópia de comparação sai com texto por cima da
        % margem. A cópia de comparação também é peça que acompanha a petição
        % (art. 57, II), então isso não é aceitável ali.
        %
        % O \emergencystretch dá ao TeX folga extra para esticar os espaços numa
        % última tentativa, antes de deixar a linha estourar. Vale só no modo
        % comparação: no documento do pedido a hifenização funciona normalmente
        % e não há razão para afrouxar o espacejamento.
        \setlength{\emergencystretch}{3em}%
    }{%
        \ifdefstring{\inpi@modocomparacao}{nao}{%
            \copiadecomparacaofalse
            \renewcommand{\inpi@marcadecomparacao}{}%
        }{%
            \PackageError{inpitex}{%
                Valor desconhecido para copiadecomparacao: '#1'.\MessageBreak
                Use sim ou nao%
            }{Corrija o valor em dados-do-pedido.tex.}%
        }%
    }%
}
\copiadecomparacao{nao}   % padrão: o documento do pedido, sem sinalização

% --- Marcação em linha, para trechos dentro de um parágrafo ---------------
%
%   \removido{trecho}          trecho suprimido
%   \incluido{trecho}          trecho acrescentado
%   \substituido{antigo}{novo} troca de um trecho por outro
%
% No documento limpo, \removido não imprime NADA (o trecho foi mesmo retirado)
% e \incluido imprime o texto sem marca alguma. É essa assimetria que faz uma
% fonte única servir às duas saídas.
\newcommand{\removido}[1]{\ifcopiadecomparacao\sout{#1}\fi}
\newcommand{\incluido}[1]{\ifcopiadecomparacao\uline{#1}\else#1\fi}
\newcommand{\substituido}[2]{%
    \ifcopiadecomparacao\sout{#1} \uline{#2}\else#2\fi
}

% --- Parágrafo inteiro removido do relatório descritivo -------------------
%
%   \paragraforemovido{texto do parágrafo suprimido}
%
% No documento limpo não imprime nada E NÃO INCREMENTA o contador, de modo que
% a numeração sequencial do art. 26, II permaneça contínua depois da supressão.
% Na cópia de comparação sai tachado, com um rótulo neutro no lugar do número,
% para deixar claro que ali havia um parágrafo numerado.
\newcommand{\paragraforemovido}[1]{%
    \ifcopiadecomparacao
        \par
        \noindent
        \hangindent\inpirecuoparagrafo
        \hangafter=1
        % \textendash e não "--": é o mesmo traço que o LaTeX produziria,
        % mas escrito de forma explícita, para ninguém "corrigir" depois.
        \makebox[\inpirecuoparagrafo][l]{[\textendash]}%
        \sout{#1}%
        \par
    \fi
}

% --- Reivindicação inteira removida do quadro -----------------------------
%
%   \reivindicacaoremovida{<número que ela tinha>}{texto da reivindicação}
%
% Use DENTRO do ambiente quadroreivindicatorio. No documento limpo não imprime
% nada e não consome número, de modo que as reivindicações restantes fiquem
% renumeradas consecutivamente, como exige o art. 28, I. Na cópia de comparação
% sai tachada, exibindo entre colchetes o número que ela tinha no quadro
% anterior — daí o primeiro argumento.
%
% O rótulo vai ENTRE COLCHETES, e isso não é estética. Impresso como "6." ele
% se confunde com a numeração viva do quadro: suprimida a reivindicação 2 de um
% quadro de quatro, a cópia de comparação saía com "1., 2. (tachada), 2., 3." —
% dois itens com o mesmo número, e o examinador sem como saber qual mapeamento
% se pretendeu. Entre colchetes, como o [--] de \paragraforemovido, o número
% antigo se lê como referência ao quadro anterior e nunca colide com o novo.
\newcommand{\reivindicacaoremovida}[2]{%
    \ifcopiadecomparacao
        \item[\sout{[#1]}]\sout{#2}%
    \fi
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%  Desenhos (arts. 26 III, 37, 38, 39) %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Declaração ÚNICA das figuras, em pedido/desenhos/figuras.tex:
%
%     \figura{nome-do-arquivo}{a vista frontal do conjunto montado (1)}
%
% O mesmo arquivo é lido duas vezes, e a macro \figura se comporta de um jeito
% em cada leitura:
%
%   - no relatório descritivo, gera a listagem exigida pelos arts. 26, III e
%     27, V ("A Figura 1 apresenta a vista frontal do conjunto montado (1).");
%   - no documento de desenhos, posiciona a imagem com o rótulo "Figura N".
%
% Assim a numeração e a ordem das figuras são consistentes por construção, e
% não há duas listas para manter em sincronia.
\newcounter{figurainpi}

% Opções padrão do \includegraphics: a figura se ajusta à caixa de texto sem
% distorção, ocupando no máximo a página inteira.
\newcommand{\inpi@opcoesfigura}{width=\linewidth,height=0.88\textheight,keepaspectratio}

% Modo "listagem" — usado no relatório descritivo.
% A norma não exige numeração de parágrafo nesta listagem (é o que os
% formulários oficiais explicitam), portanto os itens saem como parágrafos
% simples, sem o rótulo [00N].
\newcommand{\inpi@figuralistagem}[3][]{%
    \refstepcounter{figurainpi}%
    \par A Figura~\arabic{figurainpi} apresenta #3.%
}

% Art. 38, I — a figura deve ficar na página com margem esquerda e direita
% entre 1,5 cm e 2,5 cm. A \newgeometry de \abrirdesenhos fixa a CAIXA DE
% TEXTO em 2 cm de cada lado, mas a norma mede a FIGURA, e as duas coisas só
% coincidem quando a figura preenche a largura da caixa.
%
% Com 'keepaspectratio', a escala é a menor entre largura e altura: qualquer
% figura mais alta que ~1,3:1 passa a ser limitada pela altura, encolhe na
% horizontal e as margens laterais crescem sozinhas. Uma figura em retrato
% 3:16, por exemplo, sai com 8,5 cm de margem de cada lado — mais de três
% vezes o teto do art. 38, I — e nada no build reclamava.
%
% Aqui a figura é composta primeiro numa caixa, a margem lateral resultante é
% medida e comparada com a faixa da norma. O aviso vai para o .log, e o
% verificar-conformidade.sh o transforma em FALHA.
\newsavebox{\inpi@caixafigura}
\newlength{\inpi@margemlateral}

% Comprimento em milímetros inteiros, para a mensagem. 1 cm = 1864680 sp
% (arredondado de 1 cm = 28,4527559 pt), e o \dimexpr converte o \newlength,
% que é um \skip, no \dimen que o \number precisa.
\newcommand{\inpi@emmm}[1]{\the\numexpr\number\dimexpr#1\relax*10/1864680\relax}

\newcommand{\inpi@conferirmargemdafigura}[1]{%
    \setlength{\inpi@margemlateral}{\paperwidth}%
    \addtolength{\inpi@margemlateral}{-\wd\inpi@caixafigura}%
    \setlength{\inpi@margemlateral}{0.5\inpi@margemlateral}%
    \ifdim\inpi@margemlateral>2.5cm
        \PackageWarning{inpitex}{%
            Art. 38, I: a figura '#1' fica com
            \inpi@emmm{\inpi@margemlateral} mm de margem lateral,
            acima do maximo de 25 mm.\MessageBreak
            Ela e alta demais para a caixa de texto, entao encolheu na
            horizontal.\MessageBreak
            Gire a imagem para paisagem, recorte o espaco em branco em
            volta dela,\MessageBreak
            divida-a em mais de uma figura, ou passe uma largura
            explicita\MessageBreak
            em \protect\figura[...] se ela divide a pagina com outra%
        }%
    \fi
    \ifdim\inpi@margemlateral<1.5cm
        \PackageWarning{inpitex}{%
            Art. 38, I: a figura '#1' fica com
            \inpi@emmm{\inpi@margemlateral} mm de margem lateral,
            abaixo do minimo de 15 mm%
        }%
    \fi
}

% Modo "desenho" — usado no documento de desenhos. Art. 38, III: numeradas
% consecutivamente. Art. 37: várias por página, nitidamente separadas — o que
% se obtém passando uma largura menor no argumento opcional. Nesse caso a
% conferência de margem não se aplica, porque a figura divide a página com
% outra de propósito.
% O argumento opcional VAZIO (e não \inpi@opcoesfigura como valor padrão) é o
% que distingue "o autor não pediu nada" de "o autor pediu uma largura menor".
% Com o valor padrão embutido as duas situações chegam aqui indistinguíveis, e
% a conferência de margem dispararia também na figura que divide a página de
% propósito.
\newif\ifinpi@figuraplena
\newcommand{\inpi@figuradesenho}[3][]{%
    \refstepcounter{figurainpi}%
    \ifblank{#1}{%
        \let\inpi@opcoesdafigura\inpi@opcoesfigura
        \inpi@figuraplenatrue
    }{%
        \def\inpi@opcoesdafigura{#1}%
        \inpi@figuraplenafalse
    }%
    \par\addvspace{\baselineskip}%
    \begin{center}%
    \begin{singlespace}%
        \sbox\inpi@caixafigura{%
            \expandafter\includegraphics\expandafter[\inpi@opcoesdafigura]%
                {figuras/#2}%
        }%
        \ifinpi@figuraplena\inpi@conferirmargemdafigura{#2}\fi
        \usebox{\inpi@caixafigura}%
        \par\addvspace{0.5\baselineskip}%
        Figura \arabic{figurainpi}%
    \end{singlespace}%
    \end{center}%
    \par\addvspace{\baselineskip}%
}

\newcommand{\figura}{\inpi@figuralistagem}   % redefinido por \abrirdesenhos

% Arquivo de declaração das figuras. Trocável, mas o padrão serve ao template.
\newcommand{\inpi@arquivofiguras}{pedido/desenhos/figuras}
\newcommand{\arquivodefiguras}[1]{\renewcommand{\inpi@arquivofiguras}{#1}}

% Chamada no relatório descritivo, na posição do art. 27, V. O parágrafo de
% abertura é boilerplate do próprio template, por isso impresso aqui e não em
% pedido/desenhos/figuras.tex: cada \figura ali deve trazer só a frase única
% que identifica a respectiva imagem (ver o comentário-guia daquele arquivo).
\newcommand{\imprimirdescricaodosdesenhos}{%
    \par São descritas a seguir as figuras que compõem o documento de
    desenhos do presente pedido.%
    \let\figura\inpi@figuralistagem
    \input{\inpi@arquivofiguras}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%     Abertura de cada documento       %%
%%     (arts. 16, 18, 26 I e 40 I)      %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Menção que vem logo após o título, conforme a modalidade.
%
% SÓ NO RELATÓRIO DESCRITIVO. O art. 43, II ("no relatório descritivo, após o
% título, deverá constar a indicação de se tratar de certificado de adição") e
% o art. 51, II ("no relatório descritivo, após o título, deverá constar a
% indicação de se tratar de divisão") dizem em que documento a menção entra, e
% dizem só um. No resumo ela não é exigida por nada — o art. 40, I pede ali o
% título e mais nada — e é indicação de natureza processual, exatamente o que o
% art. 21 chama de "estranho à matéria do pedido". Por isso esta macro é
% chamada de \abrirrelatoriodescritivo, e não de \inpi@imprimirtitulo, que o
% resumo também usa.
\newcommand{\inpi@mencaodevinculo}{%
    \ifcertificadodeadicao
        {\par\addvspace{0.5\baselineskip}%
         Certificado de adição de invenção do \inpi@vinculado\par}%
    \fi
    \ifpedidodividido
        {\par\addvspace{0.5\baselineskip}%
         Dividido do \inpi@vinculado\par}%
    \fi
}

% Título do pedido, centralizado e separado do texto. Art. 26, I: só na página
% inicial do relatório descritivo. Art. 40, I: idem no resumo. O argumento
% opcional recebe o que vier logo abaixo do título, dentro do mesmo bloco
% centralizado — hoje, só a menção de vínculo do relatório descritivo.
\newcommand{\inpi@imprimirtitulo}[1][]{%
    \begin{center}%
    \begin{singlespace}%
        {\inpi@fontetitulo \inpi@titulo}%
        #1%
    \end{singlespace}%
    \end{center}%
    \par\addvspace{1.5\baselineskip}%
}

% Cabeçalho de identificação do documento (art. 18), centralizado no topo da
% primeira página, acima do início do texto.
\newcommand{\inpi@cabecalhodocumento}[1]{%
    \begin{center}%
    \begin{singlespace}%
        {\inpi@fontetitulo #1}%
    \end{singlespace}%
    \end{center}%
    \par\addvspace{1.5\baselineskip}%
}

% --- Relatório descritivo (art. 26, I) ---
% É o único documento que leva a menção de vínculo (arts. 43, II e 51, II).
\newcommand{\abrirrelatoriodescritivo}{%
    \inpi@imprimirtitulo[\inpi@mencaodevinculo]%
}

% --- Reivindicações (art. 18) ---
\newcommand{\abrirreivindicacoes}{%
    \inpi@cabecalhodocumento{REIVINDICAÇÕES}%
}

% --- Resumo (arts. 18 e 40, I) ---
\newcommand{\abrirresumo}{%
    \inpi@cabecalhodocumento{RESUMO}%
    \inpi@imprimirtitulo
}

% --- Desenhos (arts. 37 e 38) ---
% Art. 38, I — as figuras devem ficar dispostas na página com margem superior
% entre 2,5 cm e 4 cm; esquerda e direita entre 1,5 cm e 2,5 cm; e inferior de
% pelo menos 1 cm. Este documento tem, portanto, geometria própria, e não vale
% para ele o travamento de linhas por página do art. 17 (que trata de texto).
%
% NÃO imprime cabeçalho "DESENHOS". O art. 18 manda identificar com o termo
% correspondente apenas as reivindicações e o resumo — o documento de desenhos
% não está lá. E o art. 37 é literal: "o documento de desenhos será composto
% apenas por figuras". Um título em corpo 16 negrito no alto da primeira página
% é texto que a norma não pede em documento que ela define como só de figuras,
% e cai na vedação do art. 21. A paginação n/N do art. 16 continua, essa sim
% exigida.
\newcommand{\abrirdesenhos}{%
    \newgeometry{
        top=3cm,
        left=2cm,
        right=2cm,
        bottom=2cm,
        headheight=15pt,
        headsep=14pt,
        includehead=false,
        includefoot=false
    }%
    \let\figura\inpi@figuradesenho
}

% Percorre a declaração de figuras posicionando as imagens.
\newcommand{\imprimirdesenhos}{%
    \let\figura\inpi@figuradesenho
    \input{\inpi@arquivofiguras}%
}

% Força o início de uma nova página do documento de desenhos.
\newcommand{\novapaginadedesenhos}{\clearpage}

\endinput
