# Arquivos gerados automaticamente pela compilação LaTeX.
# Apenas os arquivos-fonte devem ser versionados.
#
# OBS.: ignoramos os PDFs COMPILADOS das quatro peças do pedido, não todo
# *.pdf — as figuras em PDF de figuras/ são fonte e continuam versionadas.

# As quatro peças do pedido (saída da compilação)
/relatorio-descritivo.pdf
/reivindicacoes.pdf
/desenhos.pdf
/resumo.pdf

# PDFs de demonstração gerados por ./gerar-exemplos.sh (o script é versionado;
# apenas os PDFs gerados são ignorados)
/exemplo-*.pdf

# Cópias de comparação geradas por ./gerar-copia-de-comparacao.sh (art. 57, II).
# Acompanham a petição, mas são saída de compilação como qualquer outra.
/*-comparacao.pdf

# Auxiliares gerais do LaTeX
*.aux
*.log
*.out
*.toc
*.synctex
*.synctex.gz
*.synctex(busy)
*.fls
*.fdb_latexmk

# --- Arquivos de sistema operacional ---
# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
